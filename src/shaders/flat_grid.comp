#version 450

/*
 * COMPUTE SHADER NOTES
 *
 * This shader owns the entire vertex buffer for the grid (positions, normals, colors).
 * Because compute shaders have very few hardware safety nets, follow these when
 * modifying or extending the shader:
 *
 * 1. GPU path is enabled by default (m_UseGPUGrid = true in GridRenderer).
 * 2. All storage buffer bindings must be valid on the descriptor set before dispatch.
 * 3. Dispatch size must cover exactly the vertex buffer (no out-of-bounds writes).
 * 4. For new logic, start with tiny dispatches (1x1 or 4x4) + validation layers.
 *
 * DYNAMIC MEMBRANE
 * ----------------
 * The grid is an elastic sheet: every grid vertex carries a (height, velocity)
 * pair and integrates a damped wave equation each frame. The gravitational-well
 * shape is the forcing term, so moving bodies and merges radiate ripples.
 * The membrane state is ping-ponged across two buffers (binding 2 = previous
 * frame, read-only; binding 3 = this frame, written) so the Laplacian always
 * samples a consistent snapshot — GridRenderer swaps them every frame.
 */

layout(local_size_x = 32, local_size_y = 32, local_size_z = 1) in;

struct Vertex {
    vec4 position;
    vec4 normal;
    vec4 color;
};

layout(std430, binding = 0) buffer VertexBuffer {
    Vertex vertices[];
};

struct BodyData {
    vec4  pos_mass;   // xyz = position, w = mass
    float size;       // visual size (for Spherical warping)
    float padding[3];
};

layout(std430, binding = 1) buffer BodiesBuffer {
    BodyData bodies[];
};

// Membrane state: one (height, velocity) per grid vertex. Ping-ponged.
struct MembraneCell {
    float height;
    float velocity;
};

layout(std430, binding = 2) readonly buffer MembraneRead {
    MembraneCell mRead[];
};

layout(std430, binding = 3) buffer MembraneWrite {
    MembraneCell mWrite[];
};

layout(push_constant) uniform PushConstants {
    int   uGridSize;
    float uScale;
    float warpGain;          // tanh sensitivity: maps mass -> well depth
    float wellDepth;         // saturated depth of the warp
    int   numBodies;
    float softeningLength;
    float radialInfluence;   // couples well width to mass
    float recenterOffset;    // mean depth subtracted (Spherical / Hyperbolic)
    int   geometryType;      // 0=Flat, 1=Spherical, 2=Hyperbolic
    int   membraneEnabled;   // 0 = instant warp, 1 = wave dynamics
    float membraneStiffness; // spring pull toward the well shape
    float membraneWaveSpeed; // ripple propagation (CFL-stable below 0.5)
    float membraneDamping;   // bleeds energy so ripples settle
} pc;

void warpFlat(vec3 basePos, uint idx, uint i, uint j);
void warpSpherical(vec3 basePos, uint idx, uint i, uint j);
void warpHyperbolic(vec3 basePos, uint idx, uint i, uint j);

void main()
{
    uint i = gl_GlobalInvocationID.x;
    uint j = gl_GlobalInvocationID.y;

    if (i > uint(pc.uGridSize) || j > uint(pc.uGridSize))
        return;

    uint vertsPerRow = uint(pc.uGridSize) + 1u;
    uint idx = i * vertsPerRow + j;

    if (idx >= vertsPerRow * vertsPerRow)
        return;

    float spacing = pc.uScale / float(pc.uGridSize);
    float center  = float(pc.uGridSize) * spacing / 2.0f;

    // Generate the correct base surface per geometry (straight port of CPU generateGrid)
    vec3 basePos;

    if (pc.geometryType == 0)
    {
        // Flat
        basePos = vec3(
            float(i) * spacing - center,
            0.0f,
            float(j) * spacing - center
        );
    }
    else if (pc.geometryType == 1)
    {
        // Spherical
        float pi = 3.14159265359;
        float theta = pi * float(i) / float(pc.uGridSize);
        float phi   = 2.0 * pi * float(j) / float(pc.uGridSize);
        float R = pc.uScale * 0.5;
        basePos = vec3(
            R * sin(theta) * cos(phi),
            R * cos(theta),
            R * sin(theta) * sin(phi)
        );
    }
    else
    {
        // Hyperbolic
        float x = (float(i) / float(pc.uGridSize) - 0.5) * pc.uScale;
        float z = (float(j) / float(pc.uGridSize) - 0.5) * pc.uScale;
        float k = pc.uScale;
        float y = (x * x - z * z) / k;
        basePos = vec3(x, y, z);
    }

    // Dispatch to the correct per-geometry implementation
    if (pc.geometryType == 0) {
        warpFlat(basePos, idx, i, j);
    } else if (pc.geometryType == 1) {
        warpSpherical(basePos, idx, i, j);
    } else if (pc.geometryType == 2) {
        warpHyperbolic(basePos, idx, i, j);
    }

    // INDEX WRITING REMAINS DISABLED FOR SAFETY
}

// ====================== GEOMETRY-SPECIFIC IMPLEMENTATIONS ======================
//
// All three share the unified warp model (must match Geometry.cpp exactly):
//
//   target = wellDepth * tanh( warpGain * Σ_body pow(mass,0.4)/softenedDist )
//
// `target` is the well shape the membrane chases; membraneStep() integrates the
// actual height. A smooth edge taper fades the warp to 0 at the grid boundary
// (Flat / Hyperbolic), then `recenterOffset` is subtracted and the height applied.

// Smoothstep falloff over the outer 15% of the grid -> flat boundary.
float edgeFade(vec3 basePos)
{
    float t = max(abs(basePos.x), abs(basePos.z)) / (pc.uScale * 0.5);
    return 1.0 - smoothstep(0.85, 1.0, t);
}

// Heat-map colour: a multi-stop white -> sky -> blue -> navy ramp. The depth is
// sqrt-boosted so even the shallow warp picks up colour and the gradient reads
// across the whole grid. Must match depthColor() in Geometry.cpp.
vec3 depthColor(float depth)
{
    float t = clamp(depth / max(pc.wellDepth, 1e-3), 0.0, 1.0);
    t = sqrt(t);

    const vec3 c0 = vec3(1.00, 1.00, 1.00);  // flat      — white
    const vec3 c1 = vec3(0.53, 0.78, 0.96);  // shallow   — sky blue
    const vec3 c2 = vec3(0.15, 0.40, 0.82);  // mid       — blue
    const vec3 c3 = vec3(0.03, 0.09, 0.34);  // deep well — navy

    if (t < 0.333)      return mix(c0, c1, t / 0.333);
    else if (t < 0.667) return mix(c1, c2, (t - 0.333) / 0.334);
    else                return mix(c2, c3, (t - 0.667) / 0.333);
}

// Advance one grid vertex's membrane height by a single damped-wave step. Reads
// the previous frame's snapshot (mRead), writes the new state (mWrite). With the
// membrane disabled the height snaps straight to `target` (the old instant warp).
float membraneStep(uint idx, uint i, uint j, uint vertsPerRow, float target)
{
    if (pc.membraneEnabled == 0)
    {
        mWrite[idx].height   = target;
        mWrite[idx].velocity = 0.0;
        return target;
    }

    float h = mRead[idx].height;
    float v = mRead[idx].velocity;

    // 4-neighbour Laplacian, with clamped (reflective) indices at the boundary.
    uint gs = uint(pc.uGridSize);
    uint iL = (i > 0u) ? i - 1u : i;
    uint iR = (i < gs) ? i + 1u : i;
    uint jD = (j > 0u) ? j - 1u : j;
    uint jU = (j < gs) ? j + 1u : j;
    float hL = mRead[iL * vertsPerRow + j ].height;
    float hR = mRead[iR * vertsPerRow + j ].height;
    float hD = mRead[i  * vertsPerRow + jD].height;
    float hU = mRead[i  * vertsPerRow + jU].height;
    float lap = hL + hR + hD + hU - 4.0 * h;

    // Symplectic Euler in per-step units (no separate dt).
    float accel = pc.membraneStiffness * (target - h)
                + pc.membraneWaveSpeed * lap
                - pc.membraneDamping   * v;
    v += accel;
    h += v;

    mWrite[idx].height   = h;
    mWrite[idx].velocity = v;
    return h;
}

// Summed gravitational potential at basePos (Euclidean distance).
float potentialSum(vec3 basePos)
{
    float sum = 0.0;
    for (int b = 0; b < pc.numBodies; ++b)
    {
        float mass = bodies[b].pos_mass.w;
        if (mass <= 0.0) continue;
        float dist  = distance(basePos, bodies[b].pos_mass.xyz);
        float m04   = pow(mass, 0.4);   // exponent must match kMassExponent (Geometry.cpp)
        float width = 1.0 + pc.radialInfluence * m04;
        float rEff  = dist / width;
        float soft  = sqrt(rEff * rEff + pc.softeningLength * pc.softeningLength);
        sum += m04 / soft;
    }
    return sum;
}

void warpFlat(vec3 basePos, uint idx, uint i, uint j)
{
    uint vertsPerRow = uint(pc.uGridSize) + 1u;
    float target = pc.wellDepth * tanh(pc.warpGain * potentialSum(basePos)) * edgeFade(basePos);
    float h = membraneStep(idx, i, j, vertsPerRow, target);
    float depth = h - pc.recenterOffset;

    vec3 finalPos = basePos;
    finalPos.y -= depth;

    vertices[idx].position = vec4(finalPos, 1.0f);
    vertices[idx].normal   = vec4(0.0f, 1.0f, 0.0f, 1.0f);
    vertices[idx].color    = vec4(depthColor(h), 1.0f);
}

void warpSpherical(vec3 basePos, uint idx, uint i, uint j)
{
    uint vertsPerRow = uint(pc.uGridSize) + 1u;
    // The sphere is closed — no edge taper.
    float target = pc.wellDepth * tanh(pc.warpGain * potentialSum(basePos));
    float h = membraneStep(idx, i, j, vertsPerRow, target);
    float depth = h - pc.recenterOffset;

    float R = pc.uScale * 0.5f;
    vec3 radialDir = normalize(basePos);
    float newRadius = max(R - depth, 0.3f * R);   // wells dimple inward
    vec3 finalPos = radialDir * newRadius;

    vertices[idx].position = vec4(finalPos, 1.0f);
    vertices[idx].normal   = vec4(radialDir, 0.0);
    vertices[idx].color    = vec4(depthColor(h), 1.0f);
}

void warpHyperbolic(vec3 basePos, uint idx, uint i, uint j)
{
    float k = pc.uScale;

    // Distance measured along the paraboloid surface (overrides potentialSum).
    float sum = 0.0;
    for (int b = 0; b < pc.numBodies; ++b)
    {
        float mass = bodies[b].pos_mass.w;
        if (mass <= 0.0) continue;
        vec3 bp = bodies[b].pos_mass.xyz;
        float diffY = (bp.x * bp.x - bp.z * bp.z) / k
                    - (basePos.x * basePos.x - basePos.z * basePos.z) / k;
        vec3 diff = vec3(bp.x - basePos.x, diffY, bp.z - basePos.z);
        float dist  = length(diff);
        float m04   = pow(mass, 0.4);   // exponent must match kMassExponent (Geometry.cpp)
        float width = 1.0 + pc.radialInfluence * m04;
        float rEff  = dist / width;
        float soft  = sqrt(rEff * rEff + pc.softeningLength * pc.softeningLength);
        sum += m04 / soft;
    }

    uint vertsPerRow = uint(pc.uGridSize) + 1u;
    float target = pc.wellDepth * tanh(pc.warpGain * sum) * edgeFade(basePos);
    float h = membraneStep(idx, i, j, vertsPerRow, target);
    float depth = h - pc.recenterOffset;

    float x = basePos.x;
    float z = basePos.z;
    vec3 surfaceNormal = normalize(vec3(-2.0f * x / k, 1.0f, 2.0f * z / k));
    vec3 finalPos = basePos - depth * surfaceNormal;

    vertices[idx].position = vec4(finalPos, 1.0f);
    vertices[idx].normal   = vec4(surfaceNormal, 0.0);
    vertices[idx].color    = vec4(depthColor(h), 1.0f);
}
